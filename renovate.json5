{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>shunichironomura/renovate-config",
    // .github/workflows/actions.lock pins action commits; gh actions-lock strips inline digests.
    "github>shunichironomura/renovate-config:actions-lock",
  ],
  packageRules: [
    {
      matchManagers: ["rust-toolchain"],
      matchDepTypes: ["toolchain"],
      addLabels: ["rust", "ci"],
    },
  ],
}
